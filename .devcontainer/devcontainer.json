{
  "build": {
    "dockerfile": "Dockerfile"
  },
  "privileged": true,
  "forwardPorts": [6080],
  "runArgs": ["--cap-add=SYS_ADMIN"],
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "postCreateCommand": "pipx install numpy && mkdir -p ~/.vnc && printf 'password\n' | vncpasswd -f > ~/.vnc/passwd && chmod 600 ~/.vnc/passwd && git clone https://github.com/novnc/noVNC.git",
  "postStartCommand": "cp -n ~/noVNC/vnc.html ~/noVNC/index.html; vncserver -geometry 1440x900 -xstartup \"cinnamon-session\" -rfbport 5900 && ./noVNC/utils/novnc_proxy --vnc 127.0.0.1:5900 --listen localhost:6080"
}
